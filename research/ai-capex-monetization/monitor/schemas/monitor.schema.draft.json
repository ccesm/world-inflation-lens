{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Research monitor envelope. All nested semantics independently rebuilt from pinned archive.",
  "type": "object",
  "required": [
    "content",
    "resultHash"
  ],
  "additionalProperties": false,
  "properties": {
    "resultHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
