{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:world-inflation-lens:ai-labor-observed-v1",
  "title": "Research-only observed labor provider dataset",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": [
        "ai-labor-observed-v1"
      ]
    },
    "provider": {
      "type": "string",
      "enum": [
        "cps",
        "ces",
        "jolts",
        "btos"
      ]
    },
    "scope": {
      "type": "string",
      "enum": [
        "RESEARCH_ONLY"
      ]
    },
    "mode": {
      "type": "string",
      "enum": [
        "CURRENT_VINTAGE_DESCRIPTIVE"
      ]
    },
    "interpretationGuardrail": {
      "type": "string",
      "minLength": 1
    },
    "confounders": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "inputManifestHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "series": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "metric": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "enum": [
              "percent",
              "thousand_jobs",
              "hours_per_week",
              "USD_per_hour_nominal"
            ]
          },
          "frequency": {
            "type": "string",
            "enum": [
              "monthly",
              "biweekly"
            ]
          },
          "seasonalAdjustment": {
            "type": "string",
            "enum": [
              "SA",
              "NSA"
            ]
          },
          "denominator": {
            "type": "string",
            "minLength": 1
          },
          "population": {
            "type": "string",
            "minLength": 1
          },
          "ageBand": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "min": {
                "type": "integer",
                "minimum": 0
              },
              "max": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              }
            },
            "additionalProperties": false
          },
          "sex": {
            "type": "string",
            "enum": [
              "all",
              "not_applicable"
            ]
          },
          "geography": {
            "type": "string",
            "minLength": 1
          },
          "industry": {
            "type": [
              "object",
              "null"
            ]
          },
          "occupation": {
            "type": [
              "object",
              "null"
            ]
          },
          "evidenceType": {
            "type": "string",
            "enum": [
              "OBSERVED_LABOR_MARKET",
              "OBSERVED_AI_ADOPTION_CONTEXT",
              "SURVEY_EXPECTATION_CONTEXT"
            ]
          },
          "question": {
            "type": "object"
          },
          "source": {
            "type": "object",
            "properties": {
              "publisher": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "pattern": "^https://"
              },
              "apiEndpoint": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "seriesId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "tableId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "retrievedAt": {
                "type": "string",
                "minLength": 20
              },
              "releaseDate": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "releaseDateBasis": {
                "type": "string",
                "minLength": 1
              },
              "rawSha256": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "license": {
                "type": "string",
                "minLength": 1
              },
              "revisionPolicy": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "publisher",
              "url",
              "apiEndpoint",
              "seriesId",
              "tableId",
              "retrievedAt",
              "releaseDate",
              "releaseDateBasis",
              "rawSha256",
              "license",
              "revisionPolicy"
            ],
            "additionalProperties": false
          },
          "observations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "period": {
                  "type": "string"
                },
                "periodStart": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "periodEnd": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "value": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "official",
                    "missing",
                    "suppressed"
                  ]
                },
                "revisionStatus": {
                  "type": "string",
                  "enum": [
                    "preliminary",
                    "revised",
                    "final",
                    "revision_unknown"
                  ]
                },
                "releaseDate": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "standardError": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "footnotes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "code": {
                        "type": "string"
                      },
                      "text": {
                        "type": "string"
                      }
                    },
                    "required": [],
                    "additionalProperties": false
                  }
                },
                "collectionStart": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "collectionEnd": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "responseShares": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "properties": {
                    "yes": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "no": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "do_not_know": {
                      "type": [
                        "number",
                        "null"
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              },
              "required": [
                "period",
                "periodStart",
                "periodEnd",
                "value",
                "status",
                "revisionStatus",
                "releaseDate",
                "standardError",
                "footnotes",
                "collectionStart",
                "collectionEnd",
                "responseShares"
              ],
              "additionalProperties": false
            }
          },
          "missingPeriods": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "title",
          "metric",
          "unit",
          "frequency",
          "seasonalAdjustment",
          "denominator",
          "population",
          "ageBand",
          "sex",
          "geography",
          "industry",
          "occupation",
          "evidenceType",
          "source",
          "observations",
          "missingPeriods",
          "limitations"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "provider",
    "scope",
    "mode",
    "interpretationGuardrail",
    "confounders",
    "inputManifestHash",
    "series"
  ],
  "additionalProperties": false
}
