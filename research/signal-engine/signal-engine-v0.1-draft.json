  "productionVersionUnchanged": "1.0.0",
  "normativeDocuments": [
    "docs/signal-engine-spec.md",
    "docs/signal-engine-factor-matrix.md",
    "docs/signal-engine-validation-plan.md"
  ],
  "outputSchema": "research/signal-engine/output.schema.json",
  "aggregation": "NONE",
  "outcomes": [
    "DOMESTIC_PURCHASING_POWER",
    "INTERNATIONAL_DOLLAR_ROLE"
  ],
  "modes": {
    "CURRENT_SNAPSHOT": {
      "supportedInPrototype": true,
      "asOfRequired": true,
      "periodCutoffRequired": false,
      "availabilityBasis": "PROJECT_ACCEPTED_SNAPSHOT",
      "historicalAvailabilityClaim": false
    },
    "CURRENT_VINTAGE_RECONSTRUCTION": {
      "supportedInPrototype": true,
      "asOfRequired": false,
      "periodCutoffRequired": true,
      "availabilityBasis": "NOT_RECONSTRUCTED",
      "historicalAvailabilityClaim": false
    },
    "RECORDED_AS_OF": {
      "supportedInPrototype": true,
      "asOfRequired": true,
      "periodCutoffRequired": false,
      "availabilityBasis": "PROJECT_ACCEPTED_SNAPSHOT",
      "historicalAvailabilityClaim": true,
      "requiresRetainedAcceptedVintage": true
    },
    "TRUE_RELEASE_VINTAGE": {
      "supportedInPrototype": false,
      "asOfRequired": true,
      "periodCutoffRequired": false,
      "availabilityBasis": "PUBLISHER_RELEASE_VINTAGE",
      "historicalAvailabilityClaim": true
    }
  },
  "inputPolicy": {
    "validatedSnapshotsOnly": true,
    "networkAccess": false,
    "writeEconomicSnapshots": false,
    "interpolation": false,
    "forwardFillObservations": false,
    "rejectUnsorted": true,
    "rejectDuplicates": true,
    "requiredWindow": "ALL_CONTIGUOUS_NATIVE_PERIODS",
    "lagBasis": "EXACT_CALENDAR_PERIOD",
    "missingLatestReportedValue": "INSUFFICIENT_DATA",
    "snapshotSelection": "LATEST_COMPLETE_ACCEPTED_DATASET_VINTAGE_AT_OR_BEFORE_ASOF",
    "modeFallback": false,
    "quarterStorageAnchor": "FIRST_MONTH_OF_FULL_QUARTER",
    "unavailableContext": "OMIT_WITH_REASON_AND_CAP_MEDIUM",
    "maxContextEndGapDays": 100,
    "contextHorizonsMustOverlap": true,
    "measurementHorizon": "CLOSED_FIRST_REQUIRED_RAW_PERIOD_START_TO_LATEST_RAW_PERIOD_END; LITERAL_CONTEXT_USES_OWN_PERIOD",
    "historicalWindowOperandFreshness": "NOT_INDIVIDUALLY_EXPIRED; REQUIRE_ELIGIBLE_SOURCE_SNAPSHOT_AND_FACTOR_ENDPOINT"
  },
  "numericPolicy": {
    "arithmetic": "IEEE754_BINARY64",
    "comparisonDecimalPlaces": 8,
    "comparisonRounding": "HALF_AWAY_FROM_ZERO",
    "displayRoundingBeforeComparison": false,
    "nonFinite": "REJECT",
    "negativeZero": "NORMALIZE_ZERO",
    "percentChangeRequiresPositiveFullWindow": true
  },
  "persistence": {
    "algorithm": "CONFIRMED_BAND_STATELESS",
    "positive": "ALL_LAST_N_GTE_ENTRY",
    "negative": "ALL_LAST_N_LTE_NEGATIVE_ENTRY",
    "quiet": "ALL_LAST_N_ABS_LTE_QUIET",
    "otherwise": "TRANSITION",
    "missing": "INSUFFICIENT_DATA",
    "count": "DISTINCT_CONSECUTIVE_OBSERVATION_PERIODS",
    "coldStart": "USE_COMPLETE_RETAINED_WINDOW",
    "revisionAddsPeriod": false,
    "unchangedCheckAddsPeriod": false
  },
  "freshness": {
    "implementation": "src/utils/freshness.js",
    "metadataContract": "src/data/seriesContract.js",
    "calendar": "src/utils/releaseCalendar.js",
    "pinCodeHashes": true,
    "admitAutomatic": [
      "CURRENT",
      "CHECKED_NO_NEW_RELEASE",
      "WAITING_FOR_EXPECTED_RELEASE"
    ],
    "withholdAutomatic": [
      "SOURCE_UPDATED_NOT_YET_CAPTURED",
      "STALE",
      "REFRESH_FAILED",
      "UNKNOWN"
    ],
    "waitingStateMap": {
      "WAITING_FOR_EXPECTED_RELEASE": "WAITING_FOR_RELEASE"
    },
    "contextOnly": [
      "MANUAL_REVIEWED",
      "MANUAL_REVIEW_REQUIRED",
      "FIXED_VINTAGE",
      "STATIC",
      "DERIVED",
      "PLANNED"
    ],
    "unknownState": "REJECT",
    "manualReviewRequired": "OMIT_WITH_REASON",
    "plannedOrStaticDirectionalInput": "REJECT",
    "lagBoundary": "PINNED_IMPLEMENTATION_PERIOD_END_PLUS_LAG_INCLUSIVE",
    "calendarBoundary": "CAPTURE_DUE_AT_EXCLUSIVE",
    "retrospectiveOperationalFreshness": "NOT_RECONSTRUCTED",
    "retrospectiveObservationLagCheck": "PINNED_POLICY_AT_PERIOD_CUTOFF"
  },
  "confidence": {
    "semantics": "EVIDENCE_QUALITY_NOT_OUTCOME_PROBABILITY",
    "orderedRules": [
      {
        "value": "UNASSESSED",
        "when": "ANY_PRIMARY_ELIGIBILITY_FAILURE",
        "direction": "INSUFFICIENT_DATA"
      },
      {
        "value": "LOW",
        "whenAny": [
          "REVISION_SENSITIVE"
        ]
      },
      {
        "value": "MEDIUM",
        "whenAny": [
          "UNKNOWN_OR_COARSE_PUBLISHER_AVAILABILITY",
          "NO_COMPARABLE_PRIOR_VINTAGE",
          "IMPUTED_PRIMARY_MEASURE",
          "UNKNOWN_IMPUTATION",
          "MISSING_OPTIONAL_CONTEXT",
          "NONCONTEMPORANEOUS_CONTEXT",
          "PARAMETER_SENSITIVE",
          "RETROSPECTIVE_AVAILABILITY_UNPROVEN",
          "SENSITIVITY_NOT_EVALUATED"
        ]
      },
      {
        "value": "HIGH",
        "when": "ALL_ELIGIBILITY_PASSED_AND_NO_PRECEDING_QUALITY_FLAGS"
      }
    ],
    "substantiveDisagreementReducesQuality": false,
    "sameEndpointPriorVintageRequiredForRevisionComparison": true
  },
  "revision": {
    "definitionBreak": "BLOCK_INCOMPATIBLE_WINDOW",
    "preserveOldArtifacts": true,
    "orderedChangeReasons": [
      "NEW_OBSERVATION",
      "REVISION_DRIVEN_CHANGE",
      "RULE_CHANGE",
      "STATUS_CHANGE",
      "CONTEXT_CHANGE",
      "INITIAL",
      "UNCHANGED"
    ],
    "noComparablePriorVintage": "UNKNOWN_NOT_STABLE"
  },
  "sensitivity": {
    "entryAndQuietJointMultipliers": [
      0.5,
      1,
      1.5
    ],
    "persistenceOffsets": [
      -1,
      0,
      1
    ],
    "minimumPersistence": 1,
    "grid": "CARTESIAN_PRODUCT",
    "chooseWinningVariant": false
  },
  "transforms": {
    "yoy_monthly": {
      "frequency": "monthly",
      "formula": "100 * (x[t] / x[t-12] - 1)",
      "units": "percent",
      "minimumPeriodsSingleResult": 13,
      "requiresPositiveFullWindow": true,
      "missing": "NULL_AND_INSUFFICIENT_DATA",
      "revisionSensitive": true
    },
    "yoy_quarterly": {
      "frequency": "quarterly",
      "formula": "100 * (x[t] / x[t-4] - 1)",
      "units": "percent",
      "minimumPeriodsSingleResult": 5,
      "requiresPositiveFullWindow": true,
      "missing": "NULL_AND_INSUFFICIENT_DATA",
      "revisionSensitive": true
    },
    "core_yoy_delta_3m": {
      "frequency": "monthly",
      "formula": "100*(x[t]/x[t-12]-1) - 100*(x[t-3]/x[t-15]-1)",
      "units": "percentage_points",
      "minimumPeriodsSingleResult": 16,
      "requiresPositiveFullWindow": true,
      "missing": "NULL_AND_INSUFFICIENT_DATA",
      "revisionSensitive": true
    },
    "gscpi_mean_delta_3m": {
      "frequency": "monthly",
      "formula": "(x[t]+x[t-1]+x[t-2])/3 - (x[t-3]+x[t-4]+x[t-5])/3",
      "units": "source_standard_deviation_units",
      "minimumPeriodsSingleResult": 6,
      "requiresPositiveFullWindow": false,
      "missing": "NULL_AND_INSUFFICIENT_DATA",
      "revisionSensitive": true
    },
    "rate_delta_3m": {
      "frequency": "monthly",
      "formula": "x[t] - x[t-3]",
      "units": "percentage_points",
      "minimumPeriodsSingleResult": 4,
      "requiresPositiveFullWindow": false,
      "missing": "NULL_AND_INSUFFICIENT_DATA",
      "revisionSensitive": true
    },
    "share_delta_8q": {
      "frequency": "quarterly",
      "formula": "x[t] - x[t-8]",
      "units": "percentage_points",
      "minimumPeriodsSingleResult": 9,
      "requiresPositiveFullWindow": false,
      "missing": "NULL_AND_INSUFFICIENT_DATA",
      "revisionSensitive": true
    }
  },
