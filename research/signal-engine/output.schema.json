{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:world-inflation-lens:offline-signal-output:0.1",
  "title": "Offline research signal output; not production",
  "description": "Structural contract only. Cross-field lineage, hashes, eligibility, formula results, mode support and factor ownership also require semantic validation. Hash this canonical payload externally; no wall-clock run log or self-hash belongs inside it.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "signal-output/0.1"
    },
    "ruleVersion": {
      "const": "signal-engine-v0.1-draft.1"
    },
    "ruleSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "outputSchemaSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "normativeDocumentHashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "minProperties": 3
    },
    "contractCodeHashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "minProperties": 3
    },
    "engineVersion": {
      "type": "string",
      "minLength": 1
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "timeZoneDatabaseVersion": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "version",
        "timeZoneDatabaseVersion"
      ]
    },
    "inputCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "inputKind": {
      "enum": [
        "VALIDATED_REPOSITORY_SNAPSHOT",
        "SYNTHETIC"
      ]
    },
    "mode": {
      "enum": [
        "CURRENT_SNAPSHOT",
        "CURRENT_VINTAGE_RECONSTRUCTION",
        "RECORDED_AS_OF",
        "TRUE_RELEASE_VINTAGE"
      ]
    },
    "asOf": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        {
          "type": "null"
        }
      ]
    },
    "periodCutoff": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        {
          "type": "null"
        }
      ]
    },
    "evaluatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "historicalAvailabilityClaim": {
      "type": "boolean"
    },
    "sensitivityScenario": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/inputSnapshot"
      }
    },
    "lineage": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lineage"
      }
    },
    "factors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/factor"
      }
    },
    "domestic": {
      "$ref": "#/$defs/outcome"
    },
    "international": {
      "$ref": "#/$defs/outcome"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "parentArtifactRef": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "ruleVersion",
    "ruleSha256",
    "outputSchemaSha256",
    "normativeDocumentHashes",
    "contractCodeHashes",
    "engineVersion",
    "runtime",
    "inputCommit",
    "inputKind",
    "mode",
    "asOf",
    "periodCutoff",
    "evaluatedAt",
    "historicalAvailabilityClaim",
    "sensitivityScenario",
    "inputs",
    "lineage",
    "factors",
    "domestic",
    "international",
    "limitations",
    "parentArtifactRef"
  ],
  "$defs": {
    "period": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "day",
            "week",
            "month",
            "quarter",
            "calendar_year",
            "fiscal_year",
            "publication_fact",
            "projection_target"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "end": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "label",
        "start",
        "end"
      ]
    },
    "timeEvidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": [
            "string",
            "null"
          ]
        },
        "precision": {
          "enum": [
            "timestamp",
            "date",
            "month",
            "unknown"
          ]
        },
        "timeZone": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidenceRef": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "value",
        "precision",
        "timeZone",
        "evidenceRef"
      ]
    },
    "inputSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "datasetId": {
          "type": "string",
          "minLength": 1
        },
        "snapshotPath": {
          "type": "string",
          "minLength": 1
        },
        "snapshotSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "rawSha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "rawRetentionLimitation": {
          "type": [
            "string",
            "null"
          ]
        },
        "inputVintageId": {
          "type": "string",
          "minLength": 1
        },
        "snapshotAcceptedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "acceptanceEvidenceRef": {
          "type": "string",
          "minLength": 1
        },
        "firstSeenAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "parserVersion": {
          "type": "string",
          "minLength": 1
        },
        "sourceMethodologyId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "datasetId",
        "snapshotPath",
        "snapshotSha256",
        "rawSha256",
        "rawRetentionLimitation",
        "inputVintageId",
        "snapshotAcceptedAt",
        "acceptanceEvidenceRef",
        "firstSeenAt",
        "parserVersion",
        "sourceMethodologyId"
      ]
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "observationPeriod": {
          "$ref": "#/$defs/period"
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "availableAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "availabilityBasis": {
          "enum": [
            "PROJECT_ACCEPTED_SNAPSHOT",
            "PUBLISHER_RELEASE_VINTAGE",
            "NOT_RECONSTRUCTED",
            "UNKNOWN"
          ]
        },
        "releasePublishedAt": {
          "$ref": "#/$defs/timeEvidence"
        },
        "revisionEventIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "observationPeriod",
        "value",
        "availableAt",
        "availabilityBasis",
        "releasePublishedAt",
        "revisionEventIds"
      ]
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
