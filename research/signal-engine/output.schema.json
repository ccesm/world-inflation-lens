            },
            {
              "type": "null"
            }
          ]
        },
        "frequency": {
          "type": "string",
          "minLength": 1
        },
        "units": {
          "type": "string",
          "minLength": 1
        },
        "denominator": {
          "type": [
            "string",
            "null"
          ]
        },
