          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 13,
          "maxItems": 13,
          "const": [
            "companyName",
            "projectName",
            "location",
            "projectStatus",
            "statusEffectiveDate",
            "statusSourceDate",
            "statusAvailableFrom",
            "capacityDisplay",
            "primaryArchetype",
            "powerSummary",
            "publicNotes",
            "publicSourceRefs",
