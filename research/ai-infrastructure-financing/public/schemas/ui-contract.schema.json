    "sectionOrder": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 4,
      "maxItems": 4,
      "const": [
        "landscape",
        "financing",
        "power",
        "boundaries"
      ]
    },
    "coreDisclosure": {
      "type": "object",
      "properties": {
        "copyKey": {
          "const": "disclosures.doubleCount"
        },
        "placement": {
          "const": "BEFORE_PROJECT_CARDS_AND_REPEATED_IN_BOUNDARIES"
        },
        "visibility": {
          "const": "ALWAYS_VISIBLE_NOT_COLLAPSED_FOOTNOTE"
        }
      },
      "required": [
        "copyKey",
        "placement",
        "visibility"
