        "keyboard",
        "nativeLinksButtonsSelects",
        "focusVisible",
        "filterLabels",
        "semanticTables",
        "textAlternative",
        "chartOnlyFacts",
        "statusNotColorOnly",
        "newTabAnnouncement",
        "zeroResultAnnouncement",
        "mapRequired"
